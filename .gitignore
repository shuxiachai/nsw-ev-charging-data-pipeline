.venv/
__pycache__/
.pytest_cache/
*.pyc
.env
.runtime/
tmp/
data/raw/*.part
data/raw/ocm/*.part
data/processed/*.building

# Local review work, secrets and generated archives stay outside Git history.
.review/
submission/
.env.*
!.env.example
*.duckdb
*.duckdb.wal
*.building
*.part

# The full frozen originals and database are supplied in the private Release.
# Keep adjacent manifests and smaller originals readable in the repository.
data/raw/**/*.pdf
data/raw/**/*.zip

# Rewritten by every scripts/verify_project.py run, so not tracked here.
# They are still packaged: scripts/package_submission.py includes outputs/, and
# README.md cites outputs/tests.xml as test evidence for the submission.
outputs/test_run.log
outputs/tests.xml

# Superseded internal review material; also excluded from the submission ZIP.
outputs/clean_environment_verification.json
docs/matching_review_20260908.md
docs/matching_review_20260908.csv
